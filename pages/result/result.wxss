.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx 180rpx;
  background: #f5f6f8;
}

/* 概览 */
.summary {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 0;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.sum-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.sum-num { font-size: 36rpx; font-weight: 600; color: #1a1a1e; }
.sum-label { font-size: 22rpx; color: #9a9ca6; margin-top: 8rpx; }
.sum-divider { width: 1rpx; height: 48rpx; background: #ececf0; }

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1e;
  margin-bottom: 24rpx;
}

/* 图纸 */
.canvas-wrap {
  width: 100%;
  background: #fafbfc;
  border: 1rpx solid #ececf0;
  border-radius: 12rpx;
}
.canvas-hint {
  font-size: 22rpx;
  color: #a8aab2;
  margin-top: 16rpx;
  line-height: 1.6;
}

/* 配色表 */
.stat-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}
.stat-row:last-child { border-bottom: none; }
.swatch {
  width: 44rpx;
  height: 44rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.12);
  flex-shrink: 0;
}
.stat-code {
  width: 96rpx;
  margin-left: 20rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #1a1a1e;
}
.stat-name {
  flex: 1;
  font-size: 26rpx;
  color: #6a6c76;
}
.stat-count {
  font-size: 26rpx;
  color: #1a1a1e;
  font-variant-numeric: tabular-nums;
}

/* 底部 */
.footer {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 24rpx calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(245, 246, 248, 0.94);
}
.footer button { margin: 0; flex: 1; }
.btn-ghost {
  background: #fff;
  color: #e2487c;
  border: 1rpx solid #e2487c;
  font-size: 32rpx;
  border-radius: 999rpx;
  line-height: 90rpx;
  height: 92rpx;
}
.btn-primary {
  background: #e2487c;
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 999rpx;
  line-height: 92rpx;
  height: 92rpx;
}
.btn-primary[disabled] { background: #e9a9c1; color: #fff; }

/* 导出画布：不能 display:none，否则拿不到节点，挪到屏幕外即可 */
.export-canvas {
  position: fixed;
  left: -99999px;
  top: 0;
}
