<view class="page">

  <!-- 概览 -->
  <view class="summary">
    <view class="sum-item">
      <text class="sum-num">{{gw}}×{{gh}}</text>
      <text class="sum-label">图纸尺寸</text>
    </view>
    <view class="sum-divider"></view>
    <view class="sum-item">
      <text class="sum-num">{{total}}</text>
      <text class="sum-label">豆子总数</text>
    </view>
    <view class="sum-divider"></view>
    <view class="sum-item">
      <text class="sum-num">{{colorKinds}}</text>
      <text class="sum-label">用色种类</text>
    </view>
  </view>

  <!-- 图纸 -->
  <view class="card">
    <view class="card-title">图纸</view>
    <scroll-view class="canvas-wrap" style="height:{{viewH}}px" scroll-x scroll-y>
      <canvas type="2d" id="pattern" style="width:{{cw}}px;height:{{ch}}px"></canvas>
    </scroll-view>
    <view class="canvas-hint">粗线每 10 格一条 · 可双向拖动查看 · 灰色格子表示留空</view>
  </view>

  <!-- 配色表 -->
  <view class="card">
    <view class="card-title">配色表（按用量排序）</view>
    <view class="stat-row" wx:for="{{stats}}" wx:key="index">
      <view class="swatch" style="background:{{item.hex}}"></view>
      <text class="stat-code">{{item.code}}</text>
      <text class="stat-name">{{item.name}}</text>
      <text class="stat-count">{{item.count}} 颗</text>
    </view>
  </view>

  <view class="footer">
    <button class="btn-ghost" bindtap="back">换张图片</button>
    <button class="btn-primary" loading="{{saving}}" disabled="{{saving}}" bindtap="saveToAlbum">保存到相册</button>
  </view>

  <!-- 导出用的高清画布，藏在屏幕外 -->
  <canvas type="2d" id="exportCanvas" class="export-canvas"
          style="width:{{exportW}}px;height:{{exportH}}px"></canvas>

</view>
