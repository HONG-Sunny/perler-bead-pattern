.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx 180rpx;
  background: #f5f6f8;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1e;
  margin-bottom: 24rpx;
}

/* 上传框 */
.dropzone {
  height: 340rpx;
  border: 2rpx dashed #c9cbd2;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #fafbfc;
}
.dropzone-plus {
  font-size: 72rpx;
  color: #b8bac2;
  line-height: 1;
  margin-bottom: 16rpx;
}
.dropzone-text { font-size: 30rpx; color: #4a4a52; }
.dropzone-hint { font-size: 24rpx; color: #9a9ca6; margin-top: 10rpx; }

/* 预览 */
.preview-img {
  width: 100%;
  height: 420rpx;
  border-radius: 16rpx;
  background: #f0f1f4;
}
.preview-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 18rpx;
  font-size: 24rpx;
  color: #9a9ca6;
}
.link { color: #e2487c; }

/* 尺寸 */
.size-row { display: flex; align-items: baseline; }
.size-big { font-size: 56rpx; font-weight: 600; color: #1a1a1e; letter-spacing: 1rpx; }
.size-unit { font-size: 26rpx; color: #9a9ca6; margin-left: 10rpx; }
.size-sub { font-size: 24rpx; color: #9a9ca6; margin: 8rpx 0 24rpx; }

.slider-scale {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #b0b2ba;
  margin-top: -6rpx;
}

/* 底部按钮 */
.footer {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  padding: 20rpx 24rpx calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(245, 246, 248, 0.94);
}
.btn-primary {
  background: #e2487c;
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 999rpx;
  line-height: 92rpx;
  height: 92rpx;
}
.btn-primary[disabled] { background: #e9a9c1; color: #fff; }

.tip {
  font-size: 24rpx;
  color: #a8aab2;
  text-align: center;
  padding: 20rpx 40rpx;
  line-height: 1.7;
}
