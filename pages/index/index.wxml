<view class="page">

  <!-- 上传区 -->
  <view class="card">
    <view class="card-title">1. 选择图片</view>

    <view wx:if="{{!imgPath}}" class="dropzone" bindtap="chooseImage">
      <view class="dropzone-plus">＋</view>
      <view class="dropzone-text">点击选择图片</view>
      <view class="dropzone-hint">支持 JPG / PNG，方形图效果最好</view>
    </view>

    <view wx:else class="preview">
      <image class="preview-img" src="{{imgPath}}" mode="aspectFit" bindtap="chooseImage" />
      <view class="preview-meta">
        <text>原图 {{imgW}} × {{imgH}} px</text>
        <text class="link" bindtap="chooseImage">重新选择</text>
      </view>
    </view>
  </view>

  <!-- 参数区 -->
  <view class="card" wx:if="{{imgPath}}">
    <view class="card-title">2. 图纸尺寸</view>

    <view class="size-row">
      <text class="size-big">{{gridW}} × {{gridH}}</text>
      <text class="size-unit">颗</text>
    </view>
    <view class="size-sub">共约 {{beadTotal}} 颗豆子 · 纵向按原图比例自动计算</view>

    <slider
      min="20" max="100" step="1" value="{{gridW}}"
      block-size="22" activeColor="#e2487c" backgroundColor="#e6e6ea"
      bindchanging="onGridChange" bindchange="onGridChange" />
    <view class="slider-scale">
      <text>20 粗糙</text>
      <text>100 精细</text>
    </view>
  </view>

  <!-- 生成 -->
  <view class="footer" wx:if="{{imgPath}}">
    <button class="btn-primary" loading="{{converting}}" disabled="{{converting}}" bindtap="generate">
      生成拼豆图纸
    </button>
  </view>

  <view class="tip" wx:if="{{!imgPath}}">
    图片会在手机本地完成转换，不会上传到任何服务器。
  </view>

</view>
